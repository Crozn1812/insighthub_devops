  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Native successful requests by workload",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_requests_total"
        }
      ]
    },
    {
      "id": 2,
      "title": "Native input tokens by workload",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_input_tokens_total"
        }
      ]
    },
    {
      "id": 3,
      "title": "Native output tokens by workload",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_output_tokens_total"
        }
      ]
    },
    {
      "id": 4,
      "title": "Native planning allocation used (not provider billing)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_planning_usd_total"
        }
      ]
    },
    {
      "id": 5,
      "title": "Native planning allocation remaining",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_budget_planning_usd - insighthub_native_planning_usd_total"
        }
      ]
    },
    {
      "id": 6,
      "title": "Native max_budget (planning USD)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_budget_planning_usd"
        }
      ]
    },
    {
      "id": 7,
      "title": "Native token throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(insighthub_native_input_tokens_total[5m]) + rate(insighthub_native_output_tokens_total[5m])"
        }
      ]
    },
    {
      "id": 8,
      "title": "Native planning budget utilization",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "insighthub_native_planning_usd_total / insighthub_native_budget_planning_usd"
        }
      ]
    },
    {
      "id": 9,
      "title": "Ollama actual provider cost USD (zero; excludes electricity)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
