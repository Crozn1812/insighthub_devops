    {
      "id": 10,
      "title": "Read-only native accounting exporter UP",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"insighthub-native-accounting\"}"
        }
      ]
    }
